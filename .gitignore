# Dependencies (install with `composer install`; the browser tests' with `npm ci`)
/vendor/
/node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Runtime output
/storage/logs/*
!/storage/logs/.gitkeep
/storage/payment-simulator.json*
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
/public/uploads/covers/*
!/public/uploads/covers/.gitkeep
*.log

# Test and analysis caches
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
/build/
/tests/_output/
# Browser tests (Playwright): results, traces and the HTML report
/test-results/
/playwright-report/
/blob-report/

# Database engine files and local dumps (export SQL instead)
*.frm
*.ibd
*.MYD
*.MYI
ibdata*
ib_logfile*
db.opt
*.sql
*.sql.gz
!/database/schema.sql
!/database/seed.sql
/database/local/

# Editors and IDEs
.idea/
.vscode/
*.code-workspace
*.sublime-*
*.swp
*~

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Backups and archives
*.bak
*.orig
*.zip
