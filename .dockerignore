# Build context for the Dockerfile: an allowlist. Everything is excluded
# except what the image needs, so secrets (.env), user uploads, logs, vendor/,
# .git and the test suite never reach the build.
*

!bin
!database
!docker
!lang
!public
!src
!composer.json
!composer.lock

# User content and local leftovers inside allowed folders.
public/uploads/avatars/*
public/uploads/covers/*
**/.env
**/.env.*
**/*.log
**/.DS_Store
**/Thumbs.db
