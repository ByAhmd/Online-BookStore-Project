# BookWise configuration.
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Real environment variables (e.g. set by your web server) override this file.

# --- Application -------------------------------------------------------
APP_NAME=BookWise
# "local" for development, "production" for a deployed site.
APP_ENV=local
# Show exception details in the browser. Must be false in production.
APP_DEBUG=false
# Public base URL of the public/ directory, without a trailing slash.
# Use https:// in production (also enables Secure cookies and HSTS).
# Used for Stripe redirect URLs and password-reset links.
#   php -S localhost:8000 -t public      -> http://localhost:8000
#   Apache alias /bookwise -> public/     -> http://localhost/bookwise
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh
# Where app.log, php-error.log and mail.log are written (relative to the project root).
LOG_DIR=storage/logs
# Interface language when the visitor has not chosen one: en or ar.
APP_DEFAULT_LOCALE=en
# Public demo mode: shows a banner and is meant to be used with the built-in
# payment simulator (see docs/DEPLOYMENT.md). Keep false for a real store.
APP_DEMO=false
# New customers must confirm their email address before they can sign in.
# Needs working email (MAIL_DRIVER=smtp) in production.
REQUIRE_EMAIL_VERIFICATION=true

# --- Database (MySQL 8.0.16+ or MariaDB 10.4+) -------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookwise
DB_USER=bookwise
DB_PASS=change-me
# TLS for hosted databases (e.g. Aiven): path to the CA certificate file, or the
# certificate text itself. Leave both empty for a local server.
DB_SSL_CA=
DB_SSL_CA_PEM=

# --- Stripe Checkout ----------------------------------------------------
# Use TEST-mode keys from https://dashboard.stripe.com/test/apikeys.
# Outside APP_ENV=production only test-mode keys (sk_test_ or rk_test_) are accepted.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret of your webhook endpoint (or from `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# ISO code of a two-decimal currency charged for book prices (JPY, KWD and other
# zero- or three-decimal currencies are refused).
STRIPE_CURRENCY=sar

# --- Email ---------------------------------------------------------------
# MAIL_DRIVER:
#   log       writes emails (including password-reset links) to
#             storage/logs/mail.log; for local development only.
#   smtp      sends real email through the SMTP server below.
#   database  demo inbox: emails are stored and shown on inbox.php instead of
#             being sent. Only works together with APP_DEMO=true.
#   null      discards every email.
MAIL_DRIVER=log
# Sender address; your email provider must allow sending from it.
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=BookWise
# SMTP server for MAIL_DRIVER=smtp, from your email provider's settings.
# 587 is the standard submission port. If your host blocks it, many
# providers also accept port 2525 (keep SMTP_ENCRYPTION=tls).
SMTP_HOST=
SMTP_PORT=587
# Leave SMTP_USERNAME empty for a server that needs no sign-in.
SMTP_USERNAME=
SMTP_PASSWORD=
# tls  = STARTTLS (ports 587 and 2525; the default)
# ssl  = TLS from the start (port 465)
# none = no encryption; only for a test server on your own machine.
SMTP_ENCRYPTION=tls
# Seconds to wait for the SMTP server before giving up.
SMTP_TIMEOUT=10
