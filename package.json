{
    "name": "bookwise-browser-tests",
    "private": true,
    "description": "Real-browser end-to-end and accessibility tests of BookWise (Playwright with axe-core), and the README screenshots. The store itself needs no Node.js.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "test:e2e": "playwright test",
        "serve:e2e": "node e2e/local-server.js",
        "screenshots": "playwright test --config=e2e/screenshots.config.js"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@playwright/test": "1.63.0",
        "axe-core": "4.13.0"
    },
    "overrides": {
        "playwright-core": "$@playwright/test"
    }
}
